<idea-plugin>
    <id>com.fastclean.generator</id>
    <name>Fast Clean Generator</name>
    <vendor email="saeidparvizi@gmail.com" url="https://github.com/saeidparvizi">Saeid Parvizi</vendor>

    <description><![CDATA[
    A powerful productivity tool to generate Flutter Clean Architecture and GetX boilerplate code instantly.<br><br>
    <b>Key Features:</b>
    <ul>
        <li>Full Project Bootstrapping (create command)</li>
        <li>Recursive Class Generation for deep JSON schemas</li>
        <li>Unified Network Layer (Dio/GetConnect supported)</li>
        <li>Smart UI component generation (Forms, Screens, Dialogs)</li>
        <li>Granular control over component generation (Entity, Model, Repository, etc.)</li>
    </ul>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.lang</depends>
    <depends>Dart</depends>
    <depends>io.flutter</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- Add extensions here -->
    </extensions>

    <actions>
        <group id="FastClean.Group" text="Clean Architecture" popup="true" icon="/icons/actionIcon.svg">
            <add-to-group group-id="NewGroup" anchor="after" relative-to-action="NewFile"/>

            <action id="FastClean.NewFeature"
                    class="com.fastclean.plugin.actions.NewFeatureAction"
                    text="Full Feature"
                    description="Generate a complete Clean Architecture feature"/>

            <separator/>

            <action id="FastClean.NewEntity"
                    class="com.fastclean.plugin.actions.NewEntityAction"
                    text="Entity Only"
                    description="Generate only the Domain Entity"/>

            <action id="FastClean.NewModel"
                    class="com.fastclean.plugin.actions.NewModelAction"
                    text="Model Only"
                    description="Generate only the Data Model"/>

            <action id="FastClean.NewRepository"
                    class="com.fastclean.plugin.actions.NewRepositoryAction"
                    text="Repository Only"
                    description="Generate only the Repository interface and implementation"/>

            <action id="FastClean.NewController"
                    class="com.fastclean.plugin.actions.NewControllerAction"
                    text="Controller Only"
                    description="Generate only the GetX Controllers"/>
        </group>
    </actions>
</idea-plugin>
