<idea-plugin>
    <id>com.fastclean.generator</id>
    <name>Fast Clean Generator</name>
    <vendor email="saeidparvizi@gmail.com" url="https://github.com/saeidparvizi">Saeid Parvizi</vendor>

    <description><![CDATA[
    A powerful tool to generate Flutter Clean Architecture and GetX boilerplate code.<br>
    Right-click on any directory (recommended lib/features) to create a new clean feature instantly.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.lang</depends>
    <depends>Dart</depends>
    <depends>io.flutter</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- Add extensions here -->
    </extensions>

    <actions>
        <action id="FastClean.NewFeature"
                class="com.fastclean.plugin.actions.NewFeatureAction"
                text="New Clean Feature"
                icon="/icons/actionIcon.svg"
                description="Generate a new Clean Architecture feature">
            <add-to-group group-id="NewGroup" anchor="after" relative-to-action="NewFile"/>
        </action>
    </actions>
</idea-plugin>
